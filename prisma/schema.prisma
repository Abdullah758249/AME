// src/lib/analytics.ts
import { prisma } from "./prisma";
import { UAParser } from "ua-parser-js"; // استيراد افتراضي غير صحيح، بل استيراد مسمى

export function parseUserAgent(ua: string) {
  const parser = new UAParser(ua);
  return {
    browser: parser.getBrowser().name || "غير معروف",
    os: parser.getOS().name || "غير معروف",
  };
}

export async function recordVisit(data: {
  path: string;
  referrer?: string;
  source?: string;
  country?: string;
  userAgent?: string;
  sessionId?: string;
}) {
  await prisma.pageVisit.create({ data });
}

export async function getAnalyticsSummary() {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const weekAgo = new Date();
  weekAgo.setDate(weekAgo.getDate() - 7);
  const monthAgo = new Date();
  monthAgo.setMonth(monthAgo.getMonth() - 1);

  const [todayCount, weekCount, monthCount, totalCount, topPages, sources, countries] = await Promise.all([
    prisma.pageVisit.count({ where: { createdAt: { gte: today } } }),
    prisma.pageVisit.count({ where: { createdAt: { gte: weekAgo } } }),
    prisma.pageVisit.count({ where: { createdAt: { gte: monthAgo } } }),
    prisma.pageVisit.count(),
    prisma.pageVisit.groupBy({
      by: ["path"],
      _count: { id: true },
      orderBy: { _count: { id: "desc" } },
      take: 10,
    }),
    prisma.pageVisit.groupBy({
      by: ["source"],
      _count: { id: true },
      orderBy: { _count: { id: "desc" } },
      take: 10,
    }),
    prisma.pageVisit.groupBy({
      by: ["country"],
      _count: { id: true },
      orderBy: { _count: { id: "desc" } },
      take: 20,
    }),
  ]);

  return {
    today: todayCount,
    week: weekCount,
    month: monthCount,
    total: totalCount,
    topPages: topPages.map(p => ({ path: p.path, count: p._count.id })),
    sources: sources.map(s => ({ source: s.source || "مباشر", count: s._count.id })),
    countries: countries.map(c => ({ country: c.country || "غير معروف", count: c._count.id })),
  };
}