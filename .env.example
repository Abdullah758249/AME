# Database — SQLite for development; PostgreSQL for production
DATABASE_URL="file:./dev.db"

# Session secret (generate: openssl rand -base64 32)
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# Admin panel URL path (not security — auth required)
ADMIN_PATH="/ame-admin"

# Public site URL (for metadata, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin (used only on first seed)
